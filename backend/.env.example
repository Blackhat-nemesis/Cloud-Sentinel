# PostgreSQL URL. Render injects this automatically from the free Render Postgres service.
# For local development, start PostgreSQL locally and use its connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudsentinel?schema=public"
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
AWS_DEFAULT_REGION=ap-south-1

# Keep these backend-only. Never add AWS_* variables to frontend/.env files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary credentials
AWS_SESSION_TOKEN=

# Real termination is intentionally not implemented/enabled in this hackathon build.
LIVE_CONTAINMENT_ENABLED=false
